-- Q07: Calculate total revenue per product\
-- Business context: Product team wants to identify\
-- top revenue-generating products to prioritise inventory\
\
SELECT\
    p.productid,\
    p.productname,\
    ROUND(SUM(od.unitprice * od.quantity * (1 - od.discount))::NUMERIC, 2) AS total_revenue\
FROM order_details od\
JOIN products p ON od.productid = p.productid\
GROUP BY p.productid, p.productname\
ORDER BY total_revenue DESC\
LIMIT 15;\
\
