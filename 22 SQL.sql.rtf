-- Q22: 
\f1\fs28 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Find customers who increased spend year over year
\f0\fs24 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 \
-- 
\f1\fs26 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 The account team wants to identify growing accounts to prioritise for upsell opportunities.
\f0\fs24 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 \
\
\
\
WITH customer_spend AS (\
\
SELECT\
c.customer_id,\
c.company_name,\
ROUND(SUM(CASE WHEN EXTRACT(YEAR FROM o.order_date) = 1996\
                 THEN od.unit_price * od.quantity * (1 - od.discount)\
                 ELSE 0 END)::NUMERIC, 2) AS spend_1996,\
\
ROUND(SUM(CASE WHEN EXTRACT(YEAR FROM o.order_date) = 1997\
                 THEN od.unit_price * od.quantity * (1 - od.discount)\
                 ELSE 0 END)::NUMERIC, 2) AS spend_1997\
FROM customers c\
JOIN orders o  \
ON c.customer_id = o.customer_id\
JOIN order_details od \
ON o.order_id  = od.order_id\
\
WHERE EXTRACT(YEAR FROM o.order_date) IN (1996, 1997)\
GROUP BY c.customer_id, c.company_name)\
\
SELECT\
    company_name,\
    spend_1996,\
    spend_1997,\
    ROUND(((spend_1997 - spend_1996) / NULLIF(spend_1996, 0) * 100)::NUMERIC, 1\
    ) AS pct_increase\
\
FROM customer_spend\
WHERE spend_1997 > spend_1996\
ORDER BY pct_increase DESC;}