\cf0 \
with country_rank as(\
select \
o.ship_country,\
p.product_name,\
round(sum(od.unit_price * od.quantity)::integer ,2) as sold\
\
from products as p\
left join order_details as od\
on p.product_id = od.product_id\
left join orders as o\
on od.order_id = o.order_id\
\
group by p.product_name, o.ship_country\
order by round(sum(od.unit_price * od.quantity)::integer ,2)),\
\
rank_product as(select \
ship_country,\
product_name,\
sold,\
rank() over(partition by ship_country order by sold desc) as rank_p\
from country_rank)\
\
select \
ship_country,\
product_name,\
sold,\
rank_p\
from rank_product\
where rank_p = 1\
\
