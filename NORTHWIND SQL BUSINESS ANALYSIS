-- ------------------------------------------------------------
-- Q07: Calculate total revenue per product
-- Business context: Product team wants to identify top
-- revenue-generating products to prioritise inventory
-- investment and promotional spend
-- ------------------------------------------------------------

SELECT
    p.product_id,
    p.product_name,
    p.category_id,
    COUNT(od.order_id)                                              AS times_ordered,
    SUM(od.quantity)                                                AS total_units_sold,
    ROUND(
        SUM(od.unit_price * od.quantity * (1 - od.discount))::NUMERIC
    , 2)                                                            AS total_revenue
FROM products p
JOIN order_details od ON p.product_id = od.product_id
GROUP BY p.product_id, p.product_name, p.category_id
ORDER BY total_revenue DESC
LIMIT 15;


-- ------------------------------------------------------------
-- Q08: Identify top 10 customers by total spend
-- Business context: Account management team needs to
-- prioritise high-value customers for a VIP loyalty program
-- NOTE: This query was missing from the original document
--       and has been added to complete the project
-- ------------------------------------------------------------

SELECT
    c.customer_id,
    c.company_name,
    ROUND(
        SUM(od.unit_price * od.quantity * (1 - od.discount))::NUMERIC
    , 2)                                                            AS total_spend
FROM customers c
JOIN orders o       ON c.customer_id = o.customer_id
JOIN order_details od ON o.order_id  = od.order_id
GROUP BY c.customer_id, c.company_name
ORDER BY total_spend DESC
LIMIT 10;


-- ------------------------------------------------------------
-- Q09: Rank employees by total sales revenue
-- Business context: Sales management wants a performance
-- leaderboard for quarterly review
-- ------------------------------------------------------------

WITH total_sales AS (

    SELECT
        CONCAT(e.first_name, ' ', e.last_name)  AS full_name,
        od.unit_price * od.quantity             AS total
    FROM order_details  AS od
    LEFT JOIN orders    AS o  ON od.order_id   = o.order_id
    LEFT JOIN employees AS e  ON o.employee_id = e.employee_id

),

emp AS (

    SELECT
        full_name,
        ROUND(SUM(total)::NUMERIC, 2)           AS all_sales
    FROM total_sales
    GROUP BY full_name

)

SELECT
    full_name,
    all_sales,
    RANK() OVER (ORDER BY all_sales DESC)       AS sales_rank
FROM emp
ORDER BY sales_rank;


-- ------------------------------------------------------------
-- Q10: Find categories with above-average product prices
-- Business context: Buying team wants to identify premium
-- categories to negotiate better supplier contracts
-- ------------------------------------------------------------

SELECT
    c.category_name,
    ROUND(AVG(p.unit_price)::NUMERIC, 2)        AS avg_price
FROM products   AS p
LEFT JOIN categories AS c ON p.category_id = c.category_id
GROUP BY c.category_name
HAVING AVG(p.unit_price) > (
    SELECT AVG(unit_price)
    FROM products
)
ORDER BY avg_price DESC;


-- ------------------------------------------------------------
-- Q11: Calculate monthly revenue trend for 1997
-- Business context: CFO wants monthly revenue movement
-- throughout 1997 to identify seasonal patterns
-- ------------------------------------------------------------

WITH monthly AS (

    SELECT
        DATE_PART('month', o.order_date)            AS month_number,
        TO_CHAR(o.order_date, 'Month')              AS month_name,
        ROUND(
            SUM(od.unit_price * od.quantity)::NUMERIC
        , 2)                                        AS total_revenue
    FROM orders         AS o
    LEFT JOIN order_details AS od ON o.order_id = od.order_id
    WHERE o.order_date BETWEEN '1997-01-01' AND '1997-12-31'
    GROUP BY DATE_PART('month', o.order_date),
             TO_CHAR(o.order_date, 'Month')

)

SELECT
    month_number,
    month_name,
    total_revenue
FROM monthly
ORDER BY month_number;


-- ------------------------------------------------------------
-- Q12: Find customers who have never placed an order
-- Business context: Marketing team wants to target inactive
-- customers with a re-engagement campaign
-- ------------------------------------------------------------

SELECT
    c.contact_name,
    c.company_name,
    c.country,
    c.phone
FROM customers  AS c
LEFT JOIN orders AS o ON o.customer_id = c.customer_id
WHERE o.customer_id IS NULL;


-- ------------------------------------------------------------
-- Q13: Identify orders with delivery gap analysis
-- Business context: Operations team wants to compare
-- promised delivery windows against actual delivery times
-- to measure fulfilment efficiency
-- ------------------------------------------------------------

WITH gap AS (

    SELECT
        order_id,
        customer_id,
        order_date,
        required_date,
        (required_date - order_date)        AS required_days,
        (shipped_date  - order_date)        AS delivery_days
    FROM orders
    WHERE shipped_date IS NOT NULL

)

SELECT
    order_id,
    customer_id,
    order_date,
    required_date,
    required_days,
    delivery_days,
    (required_days - delivery_days)         AS days_saved_or_late
FROM gap
WHERE (required_days - delivery_days) <= 0
ORDER BY days_saved_or_late ASC;


-- ------------------------------------------------------------
-- Q14: Find orders that shipped late
-- Business context: Operations team is building a
-- late-shipment report to identify fulfilment failures
-- and calculate the severity of each delay
-- ------------------------------------------------------------

SELECT
    o.order_id,
    o.customer_id,
    c.company_name,
    o.order_date,
    o.required_date,
    o.shipped_date,
    (o.shipped_date - o.required_date)      AS days_late,
    s.company_name                          AS shipped_by
FROM orders     AS o
JOIN customers  AS c ON o.customer_id = c.customer_id
JOIN shippers   AS s ON o.shipper_id  = s.shipper_id
WHERE o.shipped_date > o.required_date
  AND o.shipped_date IS NOT NULL
ORDER BY days_late DESC;

