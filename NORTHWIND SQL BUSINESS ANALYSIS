-- ------------------------------------------------------------
-- Q01: List all customers from Germany
-- Business context: Sales director wants an overview of the
-- German customer base before a regional meeting
-- ------------------------------------------------------------

SELECT
    company_name,
    contact_name,
    city,
    country
FROM customers
WHERE country = 'Germany'
ORDER BY company_name ASC;


-- ------------------------------------------------------------
-- Q02: Find products running low on stock
-- Business context: Warehouse team needs to identify products
-- at risk of stockout before the next reorder cycle
-- ------------------------------------------------------------

SELECT
    product_name,
    units_in_stock,
    reorder_level,
    (reorder_level - units_in_stock)    AS units_below_reorder
FROM products
WHERE units_in_stock < reorder_level
  AND discontinued = 0
ORDER BY units_below_reorder DESC;


-- ------------------------------------------------------------
-- Q03: Count total orders placed in 1997
-- Business context: Finance needs total order volume for
-- fiscal year 1997 for the annual report
-- ------------------------------------------------------------

SELECT
    COUNT(order_id)                     AS total_orders_1997
FROM orders
WHERE order_date BETWEEN '1997-01-01' AND '1997-12-31';


-- ------------------------------------------------------------
-- Q04: Show the most expensive products
-- Business context: A premium buyer is requesting the
-- top-tier product catalog for procurement review
-- ------------------------------------------------------------

SELECT
    product_name,
    category_id,
    unit_price
FROM products
ORDER BY unit_price DESC
LIMIT 10;


-- ------------------------------------------------------------
-- Q05: Find all employees hired before 1993
-- Business context: HR is preparing a tenure recognition
-- program for long-serving staff
-- ------------------------------------------------------------

SELECT
    CONCAT(first_name, ' ', last_name)  AS full_name,
    title,
    hire_date
FROM employees
WHERE hire_date < '1993-01-01'
ORDER BY hire_date ASC;


-- ------------------------------------------------------------
-- Q06: Calculate average freight cost by ship country
-- Business context: Logistics team is reviewing shipping
-- costs across destinations to identify saving opportunities
-- ------------------------------------------------------------

SELECT
    ship_country,
    COUNT(order_id)                     AS total_orders,
    ROUND(AVG(freight)::NUMERIC, 2)     AS avg_freight_cost
FROM orders
GROUP BY ship_country
ORDER BY avg_freight_cost DESC;

