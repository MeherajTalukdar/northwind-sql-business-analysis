-- ------------------------------------------------------------
-- Q15: Month-over-month revenue growth in 1997
-- Business context: Strategy team wants to measure business
-- momentum — are we growing faster or slower each month?
-- ------------------------------------------------------------

WITH monthly AS (

    SELECT
        DATE_PART('month', o.order_date)                AS month_number,
        ROUND(
            SUM(od.unit_price * od.quantity)::NUMERIC
        , 2)                                            AS total_revenue
    FROM orders         AS o
    LEFT JOIN order_details AS od ON o.order_id = od.order_id
    WHERE o.order_date BETWEEN '1997-01-01' AND '1997-12-31'
    GROUP BY DATE_PART('month', o.order_date)
    ORDER BY DATE_PART('month', o.order_date)

)

SELECT
    month_number,
    total_revenue,
    LAG(total_revenue) OVER (ORDER BY month_number)         AS prev_month_revenue,
    (total_revenue - LAG(total_revenue) OVER (ORDER BY month_number))
                                                            AS revenue_change,
    ROUND(
        (total_revenue - LAG(total_revenue) OVER (ORDER BY month_number))
        * 100
        / LAG(total_revenue) OVER (ORDER BY month_number)
    , 2)                                                    AS pct_growth
FROM monthly;


-- ------------------------------------------------------------
-- Q16: Customer segmentation by order frequency
-- Business context: Marketing wants to segment the customer
-- base into tiers for targeted campaign spend allocation
-- ------------------------------------------------------------

WITH cus_order AS (

    SELECT
        c.contact_name                          AS customer_name,
        COUNT(o.order_date)                     AS total_orders
    FROM customers  AS c
    INNER JOIN orders AS o ON c.customer_id = o.customer_id
    GROUP BY c.contact_name

),

segment AS (

    SELECT
        customer_name,
        total_orders,
        CASE
            WHEN total_orders > 20              THEN 'Elegant'
            WHEN total_orders BETWEEN 10 AND 20 THEN 'Premium'
            ELSE                                     'Regular'
        END                                     AS customer_segment
    FROM cus_order
    ORDER BY total_orders DESC

)

SELECT
    customer_segment,
    COUNT(*)                                    AS customer_count
FROM segment
GROUP BY customer_segment
ORDER BY customer_count DESC;


-- ------------------------------------------------------------
-- Q17: Running total of revenue by month in 1997
-- Business context: Finance team wants a cumulative revenue
-- tracker to monitor progress against annual targets
-- ------------------------------------------------------------

WITH monthly AS (

    SELECT
        DATE_PART('month', o.order_date)        AS month_number,
        ROUND(
            SUM(od.unit_price * od.quantity)::NUMERIC
        , 2)                                    AS monthly_revenue
    FROM orders         AS o
    LEFT JOIN order_details AS od ON o.order_id = od.order_id
    WHERE o.order_date BETWEEN '1997-01-01' AND '1997-12-31'
    GROUP BY DATE_PART('month', o.order_date)
    ORDER BY DATE_PART('month', o.order_date)

)

SELECT
    month_number,
    monthly_revenue,
    SUM(monthly_revenue) OVER (ORDER BY month_number)   AS cumulative_revenue
FROM monthly;


-- ------------------------------------------------------------
-- Q18: Rank products within each category by revenue
-- Business context: Category managers want their top-selling
-- products to inform promotions and stocking decisions
-- ------------------------------------------------------------

SELECT
    ctg_name,
    product_name,
    sold,
    RANK() OVER (PARTITION BY ctg_name ORDER BY sold DESC) AS rank_in_category
FROM (

    SELECT
        c.category_name                                     AS ctg_name,
        p.product_name,
        ROUND(SUM(od.unit_price * od.quantity)::NUMERIC, 2) AS sold
    FROM products       AS p
    LEFT JOIN order_details AS od ON p.product_id   = od.product_id
    LEFT JOIN categories    AS c  ON p.category_id  = c.category_id
    GROUP BY c.category_name, p.product_name

) AS product_revenue
ORDER BY ctg_name, rank_in_category;


-- ------------------------------------------------------------
-- Q19: Cohort analysis — customer retention by first order year
-- Business context: Growth team wants to understand how well
-- the business retains customers acquired in each year,
-- measured year over year
-- ------------------------------------------------------------

WITH first_orders AS (

    SELECT
        customer_id,
        MIN(DATE_PART('year', order_date))::INT     AS cohort_year
    FROM orders
    GROUP BY customer_id

),

customer_activity AS (

    SELECT DISTINCT
        customer_id,
        DATE_PART('year', order_date)::INT          AS order_year
    FROM orders

),

cohort_data AS (

    SELECT
        f.cohort_year,
        ca.order_year,
        (ca.order_year - f.cohort_year)             AS years_since_acquisition,
        COUNT(DISTINCT ca.customer_id)              AS customers_retained
    FROM first_orders       AS f
    JOIN customer_activity  AS ca ON f.customer_id = ca.customer_id
    GROUP BY f.cohort_year, ca.order_year

),

cohort_size AS (

    SELECT
        cohort_year,
        COUNT(customer_id)                          AS total_customers
    FROM first_orders
    GROUP BY cohort_year

)

SELECT
    cd.cohort_year,
    cd.order_year,
    cd.years_since_acquisition,
    cs.total_customers                              AS cohort_size,
    cd.customers_retained,
    ROUND(
        (cd.customers_retained::NUMERIC / cs.total_customers * 100)
    , 1)                                            AS retention_pct
FROM cohort_data    AS cd
JOIN cohort_size    AS cs ON cd.cohort_year = cs.cohort_year
ORDER BY cd.cohort_year, cd.order_year;


-- ------------------------------------------------------------
-- Q20: Employee performance vs team average
-- Business context: HR wants to identify which sales employees
-- are outperforming or underperforming their peers
-- ------------------------------------------------------------

WITH total_sales AS (

    SELECT
        CONCAT(e.first_name, ' ', e.last_name)  AS full_name,
        od.unit_price * od.quantity             AS total
    FROM order_details  AS od
    LEFT JOIN orders    AS o  ON od.order_id   = o.order_id
    LEFT JOIN employees AS e  ON o.employee_id = e.employee_id

),

team_avg AS (

    SELECT
        full_name,
        ROUND(SUM(total)::NUMERIC, 2)           AS all_sales,
        ROUND(
            AVG(ROUND(SUM(total)::NUMERIC, 2)) OVER ()::NUMERIC
        , 2)                                    AS grand_avg
    FROM total_sales
    GROUP BY full_name

)

SELECT
    full_name,
    all_sales,
    grand_avg,
    (all_sales - grand_avg)                     AS performance_vs_avg,
    CASE
        WHEN all_sales > grand_avg THEN 'Above Average — Bonus'
        ELSE                            'Below Average — Improve'
    END                                         AS performance_flag
FROM team_avg
ORDER BY all_sales DESC;


-- ------------------------------------------------------------
-- Q21: Identify the best-selling product per country
-- Business context: Regional sales leads each want to know
-- which single product drives the most revenue in their territory
-- ------------------------------------------------------------

WITH country_rank AS (

    SELECT
        o.ship_country,
        p.product_name,
        ROUND(SUM(od.unit_price * od.quantity)::NUMERIC, 2)     AS total_sold
    FROM products       AS p
    LEFT JOIN order_details AS od ON p.product_id   = od.product_id
    LEFT JOIN orders        AS o  ON od.order_id    = o.order_id
    GROUP BY p.product_name, o.ship_country

),

rank_product AS (

    SELECT
        ship_country,
        product_name,
        total_sold,
        RANK() OVER (
            PARTITION BY ship_country
            ORDER BY total_sold DESC
        )                                                       AS rank_p
    FROM country_rank

)

SELECT
    ship_country,
    product_name,
    total_sold,
    rank_p
FROM rank_product
WHERE rank_p = 1
ORDER BY ship_country;


-- ------------------------------------------------------------
-- Q22: Find customers who increased spend year over year
-- Business context: Account team wants to identify growing
-- accounts to prioritise for upsell opportunities
-- ------------------------------------------------------------

WITH customer_spend AS (

    SELECT
        c.customer_id,
        c.company_name,

        ROUND(SUM(
            CASE
                WHEN EXTRACT(YEAR FROM o.order_date) = 1996
                THEN od.unit_price * od.quantity * (1 - od.discount)
                ELSE 0
            END
        )::NUMERIC, 2)                          AS spend_1996,

        ROUND(SUM(
            CASE
                WHEN EXTRACT(YEAR FROM o.order_date) = 1997
                THEN od.unit_price * od.quantity * (1 - od.discount)
                ELSE 0
            END
        )::NUMERIC, 2)                          AS spend_1997

    FROM customers      AS c
    JOIN orders         AS o  ON c.customer_id = o.customer_id
    JOIN order_details  AS od ON o.order_id    = od.order_id
    WHERE EXTRACT(YEAR FROM o.order_date) IN (1996, 1997)
    GROUP BY c.customer_id, c.company_name

)

SELECT
    company_name,
    spend_1996,
    spend_1997,
    ROUND(
        ((spend_1997 - spend_1996) / NULLIF(spend_1996, 0) * 100)::NUMERIC
    , 1)                                        AS pct_increase
FROM customer_spend
WHERE spend_1997 > spend_1996
ORDER BY pct_increase DESC;
